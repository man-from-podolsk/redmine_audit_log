#!/usr/bin/env ruby
# frozen_string_literal: true

# Prints the hash of a journal password for config/audit_log.yml. Needs only Ruby (no Redmine, no bundle):
#   ruby plugins/redmine_audit_log/bin/audit_log_password
# The password is read from the terminal without echo and is never stored.

require 'io/console'
require_relative '../lib/redmine_audit_log/password'

def ask(prompt)
  $stderr.print prompt
  value = $stdin.tty? ? $stdin.noecho(&:gets) : $stdin.gets
  $stderr.puts
  value.to_s.chomp
end

password = ask('Journal password: ')
abort 'The password must be at least 12 characters.' if password.length < 12
abort 'The passwords do not match.' unless ask('Repeat: ') == password

puts RedmineAuditLog::Password.create(password)
