<% html_title l(:audit_log_title) %>

<div class="contextual">
  <%= form_tag(audit_log_verify_path, method: :post, style: 'display: inline;') do %>
    <%= submit_tag l(:audit_log_verify), class: 'button-small' %>
  <% end %>
  <%= form_tag(audit_log_lock_path, method: :post, style: 'display: inline;') do %>
    <%= submit_tag l(:audit_log_lock), class: 'button-small' %>
  <% end %>
</div>

<h2><%= l(:audit_log_title) %></h2>

<% if @config.world_readable? %>
  <p class="warning"><%= l(:audit_log_warning_world_readable, path: @config.path) %></p>
<% end %>
<% if @alerts_week.positive? %>
  <p class="warning"><%= link_to l(:audit_log_alerts_week, count: @alerts_week), audit_log_path(alerts: '1', from: 7.days.ago.to_date) %></p>
<% end %>

<style>
  #audit-log td { vertical-align: top; }
  #audit-log td.audit-time { white-space: nowrap; }
  #audit-log tr.audit-alert td { background: #fff5f5; }
  #audit-log tr.audit-alert td.audit-event { color: #c92a2a; font-weight: bold; }
  #audit-log .audit-changes { margin: 0; padding-left: 1.2em; }
  #audit-log .audit-changes li { margin: 0; }
  #audit-log del { color: #c92a2a; }
  #audit-log ins { color: #2b8a3e; text-decoration: none; }
  #audit-log details summary { cursor: pointer; color: #868e96; }
  #audit-log pre { white-space: pre-wrap; word-break: break-all; margin: 4px 0; font-size: 11px; }
</style>

<%= form_tag(audit_log_path, method: :get, id: 'query_form') do %>
  <fieldset class="collapsible">
    <legend><%= l(:label_filter_plural) %></legend>
    <div>
      <label><%= l(:audit_log_from) %> <%= date_field_tag 'from', params[:from], size: 10 %></label>
      <label><%= l(:audit_log_to) %> <%= date_field_tag 'to', params[:to], size: 10 %></label>
      <label><%= l(:audit_log_category) %>
        <%= select_tag 'category', options_for_select([[l(:label_all), '']] +
              AuditLogEntry::CATEGORIES.map { |c| [l("audit_log_category_#{c}"), c] }, params[:category]) %>
      </label>
      <label><%= l(:field_login) %> <%= text_field_tag 'user', params[:user], size: 12 %></label>
      <label>IP <%= text_field_tag 'ip', params[:ip], size: 14 %></label>
      <label><%= l(:audit_log_search) %> <%= text_field_tag 'q', params[:q], size: 18 %></label>
      <label><%= check_box_tag 'alerts', '1', params[:alerts] == '1' %> <%= l(:audit_log_only_alerts) %></label>
      <%= submit_tag l(:button_apply), name: nil, class: 'button-small' %>
      <%= link_to l(:button_clear), audit_log_path, class: 'icon icon-reload' %>
    </div>
  </fieldset>
<% end %>

<% if @entries.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
  <div class="autoscroll">
    <table class="list" id="audit-log">
      <thead>
        <tr>
          <th><%= l(:audit_log_time) %></th>
          <th><%= l(:audit_log_event) %></th>
          <th><%= l(:field_login) %></th>
          <th>IP</th>
          <th><%= l(:audit_log_what) %></th>
        </tr>
      </thead>
      <tbody>
        <% @entries.each do |entry| %>
          <tr class="<%= cycle('odd', 'even') %> <%= 'audit-alert' if entry.alert %>">
            <td class="audit-time"><%= format_time(entry.created_at) %><br><small>#<%= entry.id %></small></td>
            <td class="audit-event">
              <%= l("audit_log_category_#{entry.category}", default: entry.category) %>:
              <%= l("audit_log_event_#{entry.event}", default: entry.event) %>
              <% if entry.alert %><br><%= l(:audit_log_alert) %><% end %>
            </td>
            <td>
              <%= entry.user_login %>
              <% if entry.auth_method.present? %><br><small><%= entry.auth_method %></small><% end %>
            </td>
            <td><%= entry.ip %></td>
            <td>
              <% if entry.controller_action.present? %>
                <code><%= entry.controller_action %></code>
                <% if entry.http_method.present? %><small><%= entry.http_method %> <%= entry.path %> → <%= entry.status %></small><% end %>
              <% end %>
              <% if entry.message.present? %><div><%= entry.message %></div><% end %>
              <% changes = entry.changes_data %>
              <% if changes.is_a?(Array) && changes.any? %>
                <ul class="audit-changes">
                  <% changes.each do |change| %>
                    <li>
                      <%= l("audit_log_change_#{change['event']}", default: change['event'].to_s) %>
                      <strong><%= change['model'] %> #<%= change['id'] %></strong> <%= change['label'] %>
                      <% if change['changes'].is_a?(Hash) && change['changes'].any? %>
                        <ul>
                          <% change['changes'].each do |attribute, (before, after)| %>
                            <li><%= attribute %>: <del><%= before.to_s.truncate(200) %></del> → <ins><%= after.to_s.truncate(200) %></ins></li>
                          <% end %>
                        </ul>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              <% end %>
              <% if entry.params.present? || entry.user_agent.present? %>
                <details>
                  <summary><%= l(:audit_log_details) %></summary>
                  <% if entry.params.present? %><pre><%= entry.params %></pre><% end %>
                  <% if entry.user_agent.present? %><pre><%= entry.user_agent %></pre><% end %>
                </details>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <span class="pagination"><%= pagination_links_full @entry_pages, @entry_count %></span>
<% end %>

<p class="other-formats">
  <%= l(:label_export_to) %>
  <%= link_to 'CSV', audit_log_csv_path(request.query_parameters.except('page')) %>
</p>

<p><small>
  <%= l(:audit_log_footer, days: @config.retention_days, auditors: @config.auditors.join(', '),
        minutes: @config.unlock_minutes) %>
</small></p>
